DATABASE_URL="file:./dev.db"

# Session & Authentication Secrets
SESSION_SECRET="your-32-byte-hex-session-secret"

# Cryptographic Master Keys (32 bytes = 256 bits Hex)
AES_MESSAGE_KEY="your-32-byte-hex-aes-message-key"
CHACHA_FILE_KEY="your-32-byte-hex-chacha-file-key"
BIOMETRIC_ENCRYPTION_KEY="your-32-byte-hex-biometric-key"
STEGO_ENCRYPTION_KEY="your-32-byte-hex-stego-key"

# Internal Face Recognition Microservice Bridge
FACE_SERVICE_URL="http://127.0.0.1:8000"
FACE_SERVICE_SECRET="your-face-service-internal-token"

# Cryptographic Key Version
CURRENT_KEY_VERSION=1

